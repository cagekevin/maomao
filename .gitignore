# ════════════════════════════════════════════════════════════════
# .gitignore · 一毛AI画布多端合一（自研后端替代版）
# 依据 CLAUDE.md §四 开发红线与分层铁律整理：
#   - 运行只读 dist/，src/bundle/ 是可编辑工程源码（应入库）
#   - localTool/dist/ 是 tsc 产物（不入库）
#   - apimart-gateway/.env 含真实 AK/SK（绝不入库）
# ════════════════════════════════════════════════════════════════

# ── 依赖（体积大、可重装，不纳入版本库）──
node_modules/

# ── 构建产物 ──
# localTool 的 tsc 编译产物（由 localTool/src 重建，不入库）
localTool/dist/
# 根前端 dist/：src/bundle/ 经 `npm run build` 回灌的运行时产物，
# 运行只读、每次 build 必变，属构建产物，不入库（见 CLAUDE.md §四.2/§四.5）。
dist/
# 原型回归测试 esbuild 临时 bundle（scripts/regression_test.cjs 运行期生成，不入库）
prototypes/react-nodes/.regression-entry.cjs

# Vite / TS 构建缓存与类型增量
.vite/
*.tsbuildinfo

# ── Python ──
__pycache__/
*.pyc
apimart-gateway/venv/
# 依赖变更标记（启动脚本运行期生成，非源码）
apimart-gateway/.req_installed

# ── 环境变量 / 密钥（含真实 Lovart AK/SK，绝不入库）──
.env
.env.*
apimart-gateway/.env

# ── 闭源引擎二进制交付物（无源码、体积大，仅本地运行用）──
*.exe
一毛AI画布引擎Mac端Arm版
一毛AI画布引擎Mac端Intel版

# ── dist 原版备份（美化前的单行压缩版，仅本地回退用）──
dist-orig/

# ── readable 阅读副本（rename.cjs 生成、与 src/bundle 1:1、可随时重建，不入库）──
# 由 scripts/rename.cjs 递归生成；_smoke_checks.checkReadableParity 缺失时会自动重建。
readable/

# ── 逆向还原目录：整目录入库（含中间产物 pipeline/dist/step0_raw/verifiers），仅忽略其下的系统文件 ──
# 注：CLAUDE.md §四.4 标注此目录「AI 禁止读」，但需随仓库分发，故纳入版本库。

# ── 一键启动脚本（Mac .command）──
# 本机需可执行权限(755)以支持 ./ 双击启动；该权限为本地环境特定、易与远端
# 100644 冲突反复刷屏，故整体忽略，本地自行 chmod +x（见 docs 提及的启动方式）。
launch-all.command

# ── 运行时日志（启动脚本落盘，含 [proxy] 转发明细）──
logs/
*.log
apimart-gateway/apimart_9004.log
apimart-gateway/apimart_9004.err.log
localTool/localtool_18080.log
localTool/localtool_18080.err.log

# ── 系统 / 编辑器 / 项目数据 ──
.DS_Store
Thumbs.db

# ── 守护进程 PID 锁文件（launch-all.ps1 单实例保护，运行期生成）──
.watchdog.lock

# ── 回滚快照（snapshot.cjs 运行期生成，含完整 public 副本与 .glb/.wasm 二进制，约 60M，绝不入库）──
scripts/rollback/snapshot-*/

# ── 运行产物（每次运行/验收自动生成，随时间变化，不入库）──
# safety-net.cjs --save 的 dist 基线快照
scripts/dist-snapshot.json
# verify-ext.cjs 真机验收结果
scripts/report.json
# verify-chunks.cjs 异步 chunk 验收结果
scripts/report-chunks.json

# 注：scripts/archived/{tools,beautify,semantic-map}/ 是归档的原始脚本源码（非副本），
# 应随仓库分发供后续 AI 查阅，故不在此忽略（见 scripts/archived/README.md）。

# ── 外部学习仓库 / 第三方工具（他人仓库与嵌套 git 仓库，仅本地参考用，不入库）──
infinite-canvas别人仓库学习专用/
# tools/ 下均为第三方仓库副本（ProPainter-Webui 等嵌套 git 仓库 + ProPainter 空仓库），
# 体积大且非本工程源码，整体忽略，避免嵌套仓库导致 add 失败。
tools/

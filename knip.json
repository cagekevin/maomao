{
  "$schema": "./node_modules/knip/schema-jsonc.json",
  // ★★ 2026-09-17 ·【闸面修好】（TD-16-28 偿还② —— 权威写法，非试错）★★
  // 目标：让「只被测试引用」的生产导出判成死代码（原 `entry` 含 tests/** 时被判"已使用"⇒ 基线 0 是假绿）。
  //
  // 【官方三禁 + 唯一正道】knip.dev/guides/configuring-project-files「Production Mode」节原文点名三种**错误**做法，
  // 本仓逐条实测均无效（探针：往 src 注入一个只被 tests 引用的导出，三种配置下闸全不报）：
  //   ① `"ignore": ["**/*.test.ts"]`        —— 只**隐藏报告**，文件照样在分析图里当消费者；
  //   ② `"entry": [..., "!**/*.test.ts"]`   —— **无效**：测试由 vitest 插件注入为 entry，全局覆盖不掉；
  //   ③ `"project": [..., "!**/*.spec.ts"]` —— **无效**：同上（它们本身就是 entry）。
  //   ✅ 正道 = `knip --production`（闸已据此传参，见 scripts/check-dead-code.mjs 的调用点注释）。
  //
  // 【production 模式下**必须**给文件模式加 `!` 后缀】官方原文：production 文件集里要持续保留后缀 `!`。
  //   实测对照（2026-09-17）：只加 `--production` 而不加 `!` ⇒ 图几乎为空，只报 18 个未使用依赖、
  //   连"完全无人引用"的导出都不报（更糟）；加上 `!` 后 → 5 个未使用文件 + 80 个未使用导出 + 3 个未使用类型。
  //   非 production 运行不受 `!` 影响（实测：不加 --production 时空报告）⇒ 加后缀是安全的。
  "entry": ["src/main.tsx!"],
  "project": ["src/**/*.ts!", "src/**/*.tsx!"],
  // ═══════════════════════════════════════════════════════════════════════
  // ignore 分三组，**每条都写理由**（此前是 15 条匿名 glob：读的人分不清
  // 「产物不该看」与「有意排除但会消费 src」—— 后者才是误报之源）。
  // knip 支持 JSONC 注释（2026-09-16 实测：knip 接受、prettier 亦保留）。
  // ═══════════════════════════════════════════════════════════════════════
  "ignore": [
    // ── A. 产物 / 归档：非手写源码，分析它们只产生噪声 ──────────────────
    "dist/**", // vite 构建产物（禁手改 · CLAUDE §5.2）
    "public/**", // 扩展壳静态资源（manifest / background / icon）
    "Temp/**",
    "tmp/**",
    "logs/**",
    "test-results/**", // playwright 报告产物
    "reference-1mao/**",
    "**/archived/**",

    // ── B. 非源码 / 沙盒：不参与前端构建图 ─────────────────────────────
    "docs/**", // 含「逆向专用_ai 禁止读」（CLAUDE §5.3）
    ".codebuddy/**",
    "audit/**", // 已退役沙盒（TD-17-1：能力已并入主工程闸）
    "mockup/**",
    "packaging/**",
    // 节点蓝本样板（copy-from 用）：`_template/` 下划线=非生产目录、不占任何 registry、不会被创建/渲染
    // ⇒ 不参与生产构建图。由 `tests/unit/TemplateNode*.test.tsx` 直接 render 锁定可用性 ⇒ **有意保留**，
    // 不是死代码（故豁免于此，而非塞基线）。见该文件头 :40-46。
    "src/components/canvas/nodes/_template/**",

    // ── C. ⚠️ 会消费 src 导出、但有意排除在 knip 引用图外 ────────────────
    //   ★ 这两条 = 「knip 分析边界」所在，也是本闸**唯一系统性误报**的来源。
    //     排除它们 ⇒ src 里若有导出**只**被它们消费，knip 会判成死代码（真·误报）。
    //
    //   处理办法**不是**放宽 ignore（那只会致盲更多），而是在 src 声明处打标记：
    //       @public 跨边界消费者：<具体路径>
    //   该标记由 scripts/check-dead-code.mjs 的元层校验强制：
    //     ① 必须带「跨边界消费者：」句式　② 路径必须存在　③ 该文件必须真含这个符号名
    //   （③ 用于堵死「随手贴 @public 洗白」—— 见该脚本头的【假豁免拦截】段）
    //
    //   · scripts/**  ：闸脚本以**非字面量动态 import** 读 src 导出
    //       - check-node-types.mjs:48    → contracts.ts 的 NODE_TYPE_SET
    //       - check-api-contract.cjs:611 → contracts.ts 的 apiRegistry
    //     ⚠️ 消费方式是运行时拼路径（import(pathToFileURL(resolve(...)).href)），
    //        静态分析**原理上**解析不到 ⇒ 把 scripts 放进 entry 也没用，只有 @public 一条路。
    //   · localTool/** ：独立后端工程（自带 package.json + tsconfig），不属前端构建图。
    "scripts/**",
    "localTool/**"

    // ⚠️【2026-09-25 · 拒绝加的豁免】`videoEditorTailwindColors.ts`（文件级误报：唯一消费者 =
    //   根目录构建配置 `tailwind.config.ts:3`，属 `--production` 下不入图的构建入口）**故意不 ignore**：
    //   `ignore` 是把文件移出分析图（致盲），扩它得红是为削数字、非修事实；该误报如实留在
    //   `dead-code-baseline.json` 存量里即可（基线=不阻塞的存量，不是要"清零"的 KPI）。
    //   同理别白试：`@public` 只作用于**导出**、救不了**文件级**报告；entry/project 补
    //   `tailwind.config.ts!` 亦无效（本日各实测一次、并清过 knip 缓存）。

    // ── D. 测试（**曾误加，已删**）────────────────────────────────────────
    //   ⚠️ 不要用 `ignore` 处理测试文件：官方原文 —— 它只**隐藏报告**、不把文件排除出分析图
    //   （本仓实测同样无效：加了 ignore，只被 tests 引用的导出依旧不报）。
    //   测试的排除**只能**靠 `--production`（见本文件头「官方三禁 + 唯一正道」），故此处不再列 tests。
    //   保留本段注释只为拦住后人重加（"看着像修好了"的假收口最贵）。
  ],
  // ── 依赖豁免：**只准放"确实无法在 package.json 声明"的项** ──────────────
  // 【2026-09-16 清理取证】原 ["three-stdlib", "zustand"] 两条都是错的：
  //   · three-stdlib —— src 全库零 import（仅 PanoViewer.tsx:38 注释提到名字），
  //     它是 @react-three/drei 的传递依赖，knip 本就不报 → 冗余，删。
  //   · zustand —— src 有 7 处真实 import（videoEditor/stores/*：create + persist），
  //     但 package.json **未声明**，靠 drei / xyflow 的传递依赖 hoist 才存在。
  //     原配置用 ignoreDependencies 压住它 = **豁免掩盖真问题**：上游包一更新 zustand
  //     就可能从顶层消失，videoEditor 7 个 store 直接崩（换机 / npm ci 同风险）。
  //     已按正道修：package.json 显式声明 "zustand": "^5.0.15"（与实际 resolve 版本一致，
  //     零行为变化）→ 本表无需再豁免。
  // ⚠️ **今后 knip 报 unlisted 请去 package.json 补声明，不要往这里加** ——
  //    这个字段只该用于"确实无法声明"的极少数情况，否则就是拿豁免盖窟窿。
  "ignoreDependencies": [],
  "ignoreBinaries": [],
  "exclude": ["duplicates"],
  // 同文件内被使用的导出不算死代码（TD-22-10 取证：开启前 139 条基线里 103 条属此类误报）
  "ignoreExportsUsedInFile": true
}

{
  "name": "maomao-localtool",
  "version": "2.0.0",
  "description": "猫猫AI画布 — 本地工具服务 (替代闭源 Go 二进制)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "test": "tsc && node --test test/*.test.js",
    "db": "node scripts/db-query.mjs",
    "db:vacuum": "node scripts/db-query.mjs --vacuum"
  },
  "dependencies": {
    "jimp": "^0.22.12",
    "sql.js": "^1.10.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.6.2"
  }
}

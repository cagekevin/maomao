{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    // 2026-10-20 · P6：539 处已清零，四项「strict 之外更严」开关写回（与根 tsconfig 同口径）。
    // 顺序按 docs/plan/150：noImplicitOverride(0) → npais(402) → nua(46) → eop(91)，级联后合计 539。
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    // 2026-10-20 · P7：把「与根同口径」补全 —— 其余四项实测代价 20 处未使用形参/常量，
    // 已清零（`req` → `_req`、删除未用常量、编译期断言类型别名用 `void` 消费）。
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}

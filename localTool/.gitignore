# 本地运行日志（统一收纳到 logs/，由启动脚本生成，非源码）
logs/
# 兼容：历史散落在根目录的旧日志
localtool_run.log
localtool_err.log
localtool_18080.log
localtool_18080.err.log

# 编译产物
dist/

# 本机推理资源（深度转视频）：
#  - models/：几十 MB 权重，本地手动铺，不入库/CI
#  - vendor/：transformers.js / onnxruntime 等第三方运行时（数 MB），不入库
#    原因：transformers.min.js 含长标识符串，会被 GitHub 密钥扫描误报为 "Mistral AI API Key"，
#    故整体 gitignore；仓库靠 scripts/fetch-runtime-models.mjs + MANIFEST.json 在本地/CI 重建，
#    运行时由 localTool(18080) 的 /depth-video/* 静态宿主提供。
# 顶层 MANIFEST.json / README.md 为清单与说明，需入库（被 fetch 脚本依赖）。
runtime-models/depth-video/models/
runtime-models/depth-video/vendor/

# 测试运行输出（一次性重定向产物，非源码）
test/*-out.txt

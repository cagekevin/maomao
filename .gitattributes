# 统一换行符，避免 Windows (autocrlf) 造成的假 modified
# 文本文件统一以 LF 存储与检出
* text=auto eol=lf

# 明确按语言标记为文本
*.js      text eol=lf
*.jsx     text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.mjs     text eol=lf
*.cjs     text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.py      text eol=lf
*.ps1     text eol=lf
*.bat     text eol=lf
*.sh      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.toml    text eol=lf
*.cfg     text eol=lf
*.ini     text eol=lf
*.txt     text eol=lf
*.command text eol=lf

# 二进制文件不转换换行符
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.ico     binary
*.zip     binary
*.pdf     binary
*.woff    binary
*.woff2   binary
*.ttf     binary
*.eot     binary
*.mp4     binary
*.webm    binary
*.mov     binary
*.mp3     binary
*.wav     binary

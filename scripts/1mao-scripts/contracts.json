{
  "meta": {
    "version": "1.0.0",
    "purpose": "一毛AI画布跨端字符串契约字典。每条契约「改一处必须全端同步」，改前先查此表，改后跑 contract_scan 比对快照，任一契约命中数漂移即 FAIL（即漏改/多改）。",
    "rules": [
      "本字典是契约的唯一真相源，新增/修改契约须同步更新本文件与 CLAUDE.md §3.2。",
      "scopes 列出该契约应该出现的目录；扫描时只在 scopes 内搜，排除 node_modules、dist、docs/逆向专用_ai 禁止读。",
      "pattern 支持字符串字面量（fixed）或正则（regex）；一条契约可有多 pattern，任一命中即计入。",
      "不需要手写 expect 命中数：采用快照漂移检测——以最近一次稳定的 contract_snapshot.json 为基线，命中数变化即报警。混淆重排后数量变化属正常，此时用 `node scripts/contract_scan.cjs --resnap` 重建基线。",
      "public/assets/*.js 已被确认为 1.4.0 死副本并删除，不再纳入扫描；仅 public/background.js、public/manifest.json 等活文件在 scope 内。"
    ]
  },
  "scopes_global": [
    "src/bundle",
    "localTool/src",
    "apimart-gateway",
    "public/background.js",
    "public/manifest.json"
  ],
  "contracts": {
    "proxy_mode_local_tool": {
      "desc": "画布请求唯一出口标识：proxyMode=local-tool",
      "severity": "critical",
      "scopes": ["src/bundle", "localTool/src"],
      "patterns": [
        { "type": "fixed", "value": "proxyMode" },
        { "type": "fixed", "value": "local-tool" }
      ]
    },
    "port_18080": {
      "desc": "localTool 固定端口 127.0.0.1:18080",
      "severity": "critical",
      "scopes": ["src/bundle", "localTool/src", "public/background.js"],
      "patterns": [
        { "type": "fixed", "value": "18080" }
      ]
    },
    "port_9004": {
      "desc": "apimart-gateway 固定端口 9004（前端经变量拼接，故 bundle 内无字面量）",
      "severity": "critical",
      "scopes": ["localTool/src", "apimart-gateway"],
      "patterns": [
        { "type": "fixed", "value": "9004" }
      ]
    },
    "api_proxy_path": {
      "desc": "代理转发唯一入口 /api/proxy；localTool 负责剥信封/异步转同步",
      "severity": "critical",
      "scopes": ["src/bundle", "localTool/src"],
      "patterns": [
        { "type": "fixed", "value": "/api/proxy" }
      ]
    },
    "x_proxy_url_header": {
      "desc": "代理上游地址头 x-proxy-url（常态指向 :9004）",
      "severity": "high",
      "scopes": ["src/bundle", "localTool/src"],
      "patterns": [
        { "type": "fixed", "value": "x-proxy-url" }
      ]
    },
    "public_platform": {
      "desc": "localTool 自研平台接口前缀 /public/platform（替代官方 1mao）",
      "severity": "high",
      "scopes": ["src/bundle", "localTool/src"],
      "patterns": [
        { "type": "fixed", "value": "/public/platform" }
      ]
    },
    "envelope_code_data": {
      "desc": "前后端信封结构 {code,data}：localTool 剥信封对齐画布硬编码",
      "severity": "critical",
      "scopes": ["src/bundle", "localTool/src", "apimart-gateway"],
      "patterns": [
        { "type": "regex", "value": "[^a-zA-Z0-9_]code[^a-zA-Z0-9_].{0,12}[^a-zA-Z0-9_]data[^a-zA-Z0-9_]" },
        { "type": "fixed", "value": "t.data[0].url" }
      ]
    },
    "kv_canvas_state_v1": {
      "desc": "画布状态持久化 KV 键 canvas-state-v1",
      "severity": "medium",
      "scopes": ["src/bundle", "localTool/src", "public/background.js"],
      "patterns": [
        { "type": "fixed", "value": "canvas-state-v1" }
      ]
    },
    "kv_active_api_endpoint": {
      "desc": "当前 API endpoint 持久化 KV 键 active_api_endpoint",
      "severity": "medium",
      "scopes": ["src/bundle", "localTool/src"],
      "patterns": [
        { "type": "fixed", "value": "active_api_endpoint" }
      ]
    },
    "kv_transit_resources": {
      "desc": "转场资源持久化 KV 键 transitResources（高频 24 处，改名务必全同步）",
      "severity": "medium",
      "scopes": ["src/bundle", "localTool/src"],
      "patterns": [
        { "type": "fixed", "value": "transitResources" }
      ]
    },
    "kv_api_configs": {
      "desc": "API 配置持久化 KV 键 api_configs",
      "severity": "medium",
      "scopes": ["src/bundle", "localTool/src"],
      "patterns": [
        { "type": "fixed", "value": "api_configs" }
      ]
    },
    "local_tool_label": {
      "desc": "模式标签 local-tool（与 proxyMode 关联，但区分独立字符串）",
      "severity": "low",
      "scopes": ["src/bundle", "localTool/src"],
      "patterns": [
        { "type": "fixed", "value": "local-tool" }
      ]
    },
    "scriptbox_node_type": {
      "desc": "剧本盒子节点类型 scriptBoxNode（引擎拆分时该字符串是 UI 挂载关键，不可变）",
      "severity": "critical",
      "scopes": ["src/bundle"],
      "patterns": [
        { "type": "fixed", "value": "scriptBoxNode" }
      ]
    },
    "scriptbox_callbacks": {
      "desc": "剧本盒子 9 个引擎回调名（挂到 node.data.onXxx，组件只调不实现；改名必须组件/引擎/注入三方同步）",
      "severity": "critical",
      "scopes": ["src/bundle"],
      "patterns": [
        { "type": "fixed", "value": "onGenerateScript" },
        { "type": "fixed", "value": "onGenerateAssetImage" },
        { "type": "fixed", "value": "onGenerateAllAssetImages" },
        { "type": "fixed", "value": "onGenerateShotPrompts" },
        { "type": "fixed", "value": "onStopScriptItem" },
        { "type": "fixed", "value": "onRetryVideoAssetUpload" },
        { "type": "fixed", "value": "onUploadAllVideoAssets" },
        { "type": "fixed", "value": "onConnectShot" },
        { "type": "fixed", "value": "onConnectShots" }
      ]
    },
    "scriptbox_downstream": {
      "desc": "剧本盒子连线下游节点类型 promptNode/discountVideoNode（scriptbox 只连这两种）",
      "severity": "high",
      "scopes": ["src/bundle"],
      "patterns": [
        { "type": "fixed", "value": "promptNode" },
        { "type": "fixed", "value": "discountVideoNode" }
      ]
    }
  }
}

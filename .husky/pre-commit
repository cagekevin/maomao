#!/bin/sh
# 提交门禁（仅前端）：type-check（快）+ 只跑「改动相关」的单元测试（scripts/test-affected.cjs）
# + 三个秒级 SSR 门禁（smoke/regression/tools，防「改名后 SSR 挂」这类问题）。
#   regression/tools 已迁为 vitest 用例（ssrRegression / canvasAgentTools / demoPlan），
#   不再用 esbuild 把前端代码打成 CJS。它们在此处「无条件」跑，是因为 SSR 崩通常来自
#   src 里 .jsx→.tsx 改名，而非测试文件本身改动；test-affected 只跑与暂存改动相关的测试，
#   会漏掉这类回归，故单独保留（各 ~1.5s）。
#
# test-affected.cjs 用「源码改动 → 同名 stem 测试文件」反查，真正只跑相关测试
# （`vitest --changed` 只认改动的测试文件、漏掉源码改动触发的测试，故弃用）。
# 重测试已默认排除：imageUpscale.test.ts（真实 canvas 缩放，单次 7.4s，是全量最慢的 4 倍）
# 在 vitest.config.ts 的 exclude 里，test-affected 命中也跑不到它；需要回归时
# 用 `npm run test:unit:heavy`。日常改前端 99% 用不到它，故默认拿掉。
#
# 本地改动 localtool：本钩子不覆盖（后端是独立子项目，另有 `cd localTool && npm test`
# 与 CI 的 localtool job 两道门禁）。改 localtool 时请单独跑那一侧。
#
# 全量前端测试不再在本地重复跑：pre-push 已删除（其 `vitest run` 与下方 --changed 重叠，
# 也与 CI 的 test:coverage 重叠），全量兜底由 CI 的 frontend job 负责。本地只做快速守卫。
# lint 已移除（门禁靠类型检查 + 测试）。
#
# `set +e`：个别环境触发 git hook 时 stdout 可能是坏 fd，husky 用 `sh -e` 运行本脚本，
# 首个 echo 失败即被 set -e 中止、误判为门禁失败。故关闭 errexit；门禁结论纯由末行命令退出码推导。
set +e
npm run type-check
tc=$?
node scripts/test-affected.cjs
vt=$?
node scripts/smoke_test.cjs
sm=$?
npm run test:regression
rg=$?
npm run test:tools
tl=$?
[ "$tc" -eq 0 ] && [ "$vt" -eq 0 ] && [ "$sm" -eq 0 ] && [ "$rg" -eq 0 ] && [ "$tl" -eq 0 ]

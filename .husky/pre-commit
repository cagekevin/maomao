#!/bin/sh
# 提交门禁：type-check（快）+ 只跑「改动相关」的单元测试（vitest --changed，~2-3s）。
# 全量单元测试放 pre-push（push 前才跑，兜底）。
# 设计取舍：commit 时用 --changed 早抓「本次改动」的回归，又不必每次等全量(20s)；push 前全量保安全。
# lint 已移除（门禁靠类型检查 + 测试）。
#
# ⚠️ 排查提示：Windows/Git 在 commit 时会吞掉 hook 的 stderr，若只看到 "exit code 1" 而无报错，
#    往往就是下方两个环节之一失败。本脚本对每个命令单独判退出码并输出醒目提示，失败必见环节名。

gates_passed=1   # 0=通过 1=失败

echo "▶ [1/2] type-check (tsc --noEmit)"
if ! npm run type-check 2>&1; then
  echo ""
  echo "❌ [pre-commit] type-check 失败 —— 存在 TypeScript 类型错误，修复后重试提交。"
  gates_passed=0
fi

echo ""
echo "▶ [2/2] unit tests (vitest run --changed, 改动相关)"
if ! npx vitest run --changed 2>&1; then
  echo ""
  echo "❌ [pre-commit] vitest --changed 存在失败测试 —— 修复失败的用例后重试提交。"
  gates_passed=0
fi

echo ""
if [ "$gates_passed" -ne 0 ]; then
  echo "✅ [pre-commit] 门禁通过（type-check + vitest --changed 均绿）。"
else
  echo "❌❌ [pre-commit] 门禁未通过，已阻止提交。上方是失败环节与提示，直接定位即可。"
  exit 1
fi
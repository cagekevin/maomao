#!/bin/sh
# 提交门禁：type-check（快）+ 只跑「改动相关」的单元测试（vitest --changed）。
# 全量单元测试放 pre-push（push 前才跑，兜底）。lint 已移除（门禁靠类型检查 + 测试）。
#
# `set +e`：个别环境（特定 shell / 部分 CI）触发 git hook 时其 stdout 可能是坏 fd（sh 报
# "echo: write error: Bad file descriptor"），而 husky 用 `sh -e` 运行本脚本，首个 echo 失败
# 即被 set -e 中止、误判为门禁失败。故关闭 errexit；门禁结论纯由下方命令退出码推导（末行 `[ ]`）。
set +e
npm run type-check
tc=$?
npx vitest run --changed
vt=$?
[ "$tc" -eq 0 ] && [ "$vt" -eq 0 ]
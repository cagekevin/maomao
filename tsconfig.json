{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "incremental": true,

    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,

    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,

    "types": ["node", "vite/client", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    // 根配置：2026-09-02 随全仓 TS 化（.js→.ts），现已可被 tsc 真校验。
    // 此前只列 vite/vitest 两个 .js，且 allowJs:true + checkJs:false → 配置层零类型安全，
    // 写错插件名/选项键只能等构建或运行时炸。
    // 不含 postcss.config.js：它刻意保持 .js（postcss-load-config@6 加载 .ts 需 ts-node，
    // 为一个 6 行插件表引入依赖不划算，详见该文件头注释）。
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.logic.config.ts",
    "playwright.config.ts",
    "tailwind.config.ts",
    // 全盘扫描（2026-09-12）：并入 tests，取消独立的 tests/tsconfig.json。
    // 此前 tests 走独立 tsconfig（lib ES2022 + checkJs:true 罩 .mjs 底座），
    // 主配置只扫 src。现统一由本配置一次扫描，lib/target 取主配置口径。
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "tests/**/*.mjs"
  ],
  "exclude": ["node_modules", "dist", "dev"]
}

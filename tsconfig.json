{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "incremental": true,

    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,

    // ✅ 2026-09-13 起 src 全量启用严格模式；同日 tests 也全量纳入本配置（strict 全开、零放宽），
    // 存量约 866 处报错（隐式 any 系为主，见 `npm run type-check`）按文件逐个收口。
    // 全开 strict 总开关 + noImplicitAny + strictNullChecks + noUnusedLocals / noUnusedParameters / noImplicitReturns。
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,

    "types": ["node", "vite/client", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@videoEditor/*": ["./src/components/videoEditor/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    // 根配置：2026-09-02 随全仓 TS 化（.js→.ts），现已可被 tsc 真校验。
    // 此前只列 vite/vitest 两个 .js，且 allowJs:true + checkJs:false → 配置层零类型安全，
    // 写错插件名/选项键只能等构建或运行时炸。
    // 不含 postcss.config.js：它刻意保持 .js（postcss-load-config@6 加载 .ts 需 ts-node，
    // 为一个 6 行插件表引入依赖不划算，详见该文件头注释）。
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.logic.config.ts",
    "playwright.config.ts",
    "tailwind.config.ts",
    // 全盘扫描（2026-09-12）：并入 tests，取消独立的 tests/tsconfig.json。
    // 此前 tests 走独立 tsconfig（lib ES2022 + checkJs:true 罩 .mjs 底座），
    // 主配置只扫 src。现统一由本配置一次扫描，lib/target 取主配置口径。
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "tests/**/*.mjs"
  ],
  // _legacy：2026-09-14 自建 videoEditor 退役归档（docs/130-cutia搬迁计划书）。
  // 它是**只读留痕**，不参与编译/测试——引用的旧路径已不复存在，纳入会让 type-check 全红。
  "exclude": ["node_modules", "dist", "dev", "src/components/videoEditor/_legacy"]
}

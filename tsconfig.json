{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "incremental": true,
    // 增量缓存的落点显式收进 logs/（默认写在 tsconfig 同级 ⇒ 根目录会不断长出裸文件
    // tsconfig.tsbuildinfo）。logs/ 已被 .gitignore:95 覆盖，且与 build_*.log 同属「构建期产物」。
    "tsBuildInfoFile": "./logs/tsconfig.tsbuildinfo",

    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,

    // ✅ 2026-09-13 起 src 全量启用严格模式；同日 tests 也全量纳入本配置（strict 全开、零放宽），
    // 存量约 866 处报错（隐式 any 系为主，见 `npm run type-check`）按文件逐个收口。
    // 全开 strict 总开关 + noImplicitAny + strictNullChecks + noUnusedLocals / noUnusedParameters / noImplicitReturns。
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    // 2026-10-19 · P0：strict 之外的三项零成本收紧（实测各 0 错，见 docs/plan/150）。
    "noFallthroughCasesInSwitch": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    // 2026-10-19 · P1：47 处 override 已收口，开关写回主配置。
    "noImplicitOverride": true,
    // 2026-10-19 · P2：18 处 import type 已收口，开关写回主配置。
    "verbatimModuleSyntax": true,
    // 2026-10-19 · P3：471 处 eop 已清零，开关写回主配置。
    "exactOptionalPropertyTypes": true,
    // 2026-10-20 · P4：src 869 + tests 1227 处已清零，开关写回主配置。
    // 全量 3368 用例通过；此后 `arr[i]` 的 `T | undefined` 由编译器强制面对。
    "noUncheckedIndexedAccess": true,
    // 2026-10-20 · P5：src 505 + tests 401 处 TS4111 已清零，开关写回主配置。
    // A 类（真字典：LLM 入参 / 外部 JSON / node.data）改方括号 + 边界归一；
    // B 类假字典（ScriptBoxData / promptHubStore / ProjectObject）补显式字段后删索引签名。
    "noPropertyAccessFromIndexSignature": true,

    "types": ["node", "vite/client", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    // 根配置：2026-09-02 随全仓 TS 化（.js→.ts），现已可被 tsc 真校验。
    // 此前只列 vite/vitest 两个 .js，且 allowJs:true + checkJs:false → 配置层零类型安全，
    // 写错插件名/选项键只能等构建或运行时炸。
    // 不含 postcss.config.js：它刻意保持 .js（postcss-load-config@6 加载 .ts 需 ts-node，
    // 为一个 6 行插件表引入依赖不划算，详见该文件头注释）。
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.logic.config.ts",
    "playwright.config.ts",
    "tailwind.config.ts",
    // 全盘扫描（2026-09-12）：并入 tests，取消独立的 tests/tsconfig.json。
    // 此前 tests 走独立 tsconfig（lib ES2022 + checkJs:true 罩 .mjs 底座），
    // 主配置只扫 src。现统一由本配置一次扫描，lib/target 取主配置口径。
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "tests/**/*.mjs"
  ],
  // 更新(2026-09-14)：原 exclude 的 `src/components/videoEditor/_legacy`（自建 videoEditor 退役归档）
  // 已整体删除 —— 用户裁定「legacy 包括 test legacy 全删」。删前已证死：全库活引用 0（仅注释提及）。
  "exclude": ["node_modules", "dist", "dev"]
}
